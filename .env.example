PORT=3000
BEARER_TOKEN=my-secret-token-12345

# Google Gemini API key (Cloud mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Local LLM mode via LM Studio / Ollama (Local mode)
# Set LLM_PROVIDER=lmstudio to use your local LM Studio server
LLM_PROVIDER=mock
LOCAL_LLM_URL=http://127.0.0.1:1234/v1/chat/completions
LOCAL_LLM_MODEL=local-model
